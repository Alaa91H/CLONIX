<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.clonix.app">
    <!-- NOTE: no sharedUserId on purpose: the standalone build is NOT
         platform-signed, and android.uid.system requires the platform cert.
         All powers come from privapp-permissions allowlist / root instead. -->

    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.MANAGE_USERS" />
    <uses-permission android:name="android.permission.CREATE_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS_FULL" />
    <uses-permission android:name="android.permission.MANAGE_PROFILE_AND_DEVICE_OWNERS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_SHORTCUTS" />

    <application
        android:name=".ClonixApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clonix"
        android:directBootAware="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- launcher entry (Home tab) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.clonix.app.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- Entry from system Settings -->
            <intent-filter>
                <action android:name="com.clonix.app.OPEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- LOCAL APPS screen -->
        <activity
            android:name=".AppsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.clonix.app.APPS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Schedules tab -->
        <activity
            android:name=".SchedulesActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.clonix.app.SCHEDULES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Account tab -->
        <activity
            android:name=".AccountActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.clonix.app.ACCOUNT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Trampoline to launch a clone from shortcut without Launcher patch -->
        <activity
            android:name=".LauncherTrampoline"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <activity
            android:name=".StorageActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.clonix.app.STORAGE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.clonix.app.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".BackupCenterActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.clonix.app.BACKUP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ArchivesActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.clonix.app.ARCHIVES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- DASHBOARD action → Storage (absorbed the old dashboard). -->
        <activity-alias
            android:name=".DashboardActivity"
            android:exported="true"
            android:targetActivity=".StorageActivity">
            <intent-filter>
                <action android:name="com.clonix.app.DASHBOARD" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".AppDetailActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="com.clonix.app.APPDETAIL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".DeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="false">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_STARTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PackageCleanupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- Pin confirmation callback (system-fired only). -->
        <receiver
            android:name=".PinResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.clonix.app.PIN_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Headless test hook: shell/root (adb) only, enforced in code. -->
        <receiver
            android:name=".TestHookReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.clonix.app.TEST" />
            </intent-filter>
        </receiver>

        <!-- Secure file sharing (archives/APKs via system sharesheet). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.clonix.app.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Periodic keep-alive for background clone users (notifications). -->
        <service
            android:name=".KeepAliveJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Scheduled batch backups (all tracked, non-blacklisted clones). -->
        <service
            android:name=".BackupScheduler$SchedJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Scheduled integrity verification (all archives). -->
        <service
            android:name=".VerifyScheduler$SchedJob"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Screen-off auto-freeze watcher (foreground: zero polling). -->
        <service
            android:name=".AutoFreezeService"
            android:exported="false" />

        <!-- Quick Settings tile: wake all clones on demand. -->
        <service
            android:name=".QuickTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>
</manifest>
