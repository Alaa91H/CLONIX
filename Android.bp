// CLONIX - independent app cloner (clone profile + hidden users).
// System privileged app. Same APK, N copies via hidden users.
// Slot 1 = Clone profile (concurrent, no work tab).
// Slot 2..N = Secondary users started in background.

android_app {
    name: "Clonix",
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    static_libs: [
        "com.google.android.material_material",
        "androidx.recyclerview_recyclerview",
    ],
    platform_apis: true,
    privileged: true,
    system_ext_specific: false,
    certificate: "platform",
    required: ["privapp-permissions-com.clonix.app"],
    optimize: {
        enabled: true,
        shrink: true,
    },
    apex_available: ["//apex_available:platform"],
    min_sdk_version: "29",
    target_sdk_version: "34",
}

prebuilt_etc {
    name: "privapp-permissions-com.clonix.app",
    src: "etc/privapp-permissions-com.clonix.app.xml",
    sub_dir: "permissions",
}
