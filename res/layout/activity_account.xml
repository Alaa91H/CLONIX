<?xml version="1.0" encoding="utf-8"?>
<!-- ACCOUNT tab: brand header + device card + rows list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        android:gravity="center_vertical">

        <Space
            android:layout_width="40dp"
            android:layout_height="40dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:letterSpacing="0.08"
            android:textStyle="bold"
            android:gravity="center" />

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_circle">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_account_outline"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/acc_card_title"
                style="@style/TextAppearance.Clonix.SectionHeader"
                android:textAllCaps="true"
                android:letterSpacing="0.12" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardElevation="0dp"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textAppearance="?attr/textAppearanceTitleMedium" />

                    <TextView
                        android:id="@+id/acc_device"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/acc_counts"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/acc_mode_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_stat_chip"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textStyle="bold"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/acc_settings"
                style="@style/TextAppearance.Clonix.SectionHeader"
                android:textAllCaps="true"
                android:letterSpacing="0.12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_overview_card"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/row_settings"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/acc_settings" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_set_palette"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_archives"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/acc_archives" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_nav_archives_outline"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_language"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/acc_language" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_set_globe"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_help"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/set_help_center" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sb_help"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_contact"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/set_contact" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sb_send"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_rate"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/acc_rate" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sb_star"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_share"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/acc_share" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_sb_share"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/row_about"
                    style="@style/SheetRow"
                    android:paddingHorizontal="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        style="@style/SheetRowText"
                        android:text="@string/acc_about" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_set_info"
                        android:importantForAccessibility="no" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
